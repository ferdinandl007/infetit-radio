diff --git a/external/ggml/src/ggml-metal/ggml-metal.metal b/external/ggml/src/ggml-metal/ggml-metal.metal
--- a/external/ggml/src/ggml-metal/ggml-metal.metal
+++ b/external/ggml/src/ggml-metal/ggml-metal.metal
@@ -8635,6 +8635,20 @@
 template [[host_name("kernel_cpy_q5_1_f16")]] kernel cpy_q_f_t kernel_cpy_q_f32<half4x4, block_q5_1, 2, dequantize_q5_1>;
 template [[host_name("kernel_cpy_q8_0_f16")]] kernel cpy_q_f_t kernel_cpy_q_f32<half4x4, block_q8_0, 2, dequantize_q8_0>;
 
+// Copy aligned FP16 buffers as raw bits, including any FP16 payloads.
+kernel void kernel_concat_f16_vector(
+        constant uint2 & counts,
+        device const uint4 * left,
+        device const uint4 * right,
+        device uint4 * output,
+        uint index [[thread_position_in_grid]]) {
+    if (index < counts.x) {
+        output[index] = left[index];
+    } else if (index < counts.y) {
+        output[index] = right[index - counts.x];
+    }
+}
