     if (!t) {
@@ -650,6 +651,42 @@
 
     const int32_t dim = ((const int32_t *) op->op_params)[0];
 
+    // Vectorized concat follows llama.cpp #32824. A single batch joined
+    // on the sequence axis consists of two flat spans for contiguous F16.
+    static const bool vector_concat = [] {
+        const char * value = std::getenv("VIBE_YUE2_METAL_VECTOR_CONCAT");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    if (vector_concat && dim == 2 && ne3 == 1 && op->type == GGML_TYPE_F16 &&
+        ggml_is_contiguous(op->src[0]) && ggml_is_contiguous(op->src[1]) && ggml_is_contiguous(op)) {
+        constexpr size_t vector_bytes = 16;
+        const auto left_size = ggml_nbytes(op->src[0]);
+        const auto total_size = ggml_nbytes(op);
+        const auto left = ggml_metal_get_buffer_id(op->src[0]);
+        const auto right = ggml_metal_get_buffer_id(op->src[1]);
+        const auto output = ggml_metal_get_buffer_id(op);
+        if (total_size / vector_bytes <= UINT32_MAX &&
+            (left_size | total_size | left.offs | right.offs | output.offs) % vector_bytes == 0) {
+            const char * name = "kernel_concat_f16_vector";
+            auto pipeline = ggml_metal_library_get_pipeline(lib, name);
+            if (!pipeline.pipeline) {
+                pipeline = ggml_metal_library_compile_pipeline(lib, name, name, nullptr);
+            }
+            if (pipeline.pipeline) {
+                uint32_t counts[] = {uint32_t(left_size / vector_bytes), uint32_t(total_size / vector_bytes)};
+                constexpr int threads = 256;
+                ggml_metal_encoder_set_pipeline(enc, pipeline);
+                ggml_metal_encoder_set_bytes(enc, counts, sizeof(counts), 0);
+                ggml_metal_encoder_set_buffer(enc, left, 1);
+                ggml_metal_encoder_set_buffer(enc, right, 2);
+                ggml_metal_encoder_set_buffer(enc, output, 3);
+                ggml_metal_encoder_dispatch_threadgroups(enc, (uint64_t(counts[1]) + threads - 1) / threads,
+                                                         1, 1, threads, 1, 1);
+                return 1;
+            }
+        }
+    }
