@@ -331,6 +333,21 @@ core::TensorValue snake_beta(
     const modules::SnakeBeta1dWeights & weights,
     int64_t channels,
     bool logscale) {
+    const char * fused = std::getenv("AUDIOCPP_OOBLECK_METAL_SNAKE");
+    if (ctx.backend_type == core::BackendType::Metal && (!fused || std::string_view(fused) != "0") &&
+        input.type == GGML_TYPE_F32 && input.tensor->ne[1] == channels &&
+        input.tensor->ne[2] == 1 && input.tensor->ne[3] == 1) {
+        const auto contiguous = core::ensure_backend_addressable_layout(ctx, input);
+        auto * alpha = weights.alpha.tensor;
+        auto * beta = weights.beta.tensor;
+        if (logscale) {
+            alpha = ggml_exp(ctx.ggml, alpha);
+            beta = ggml_exp(ctx.ggml, beta);
+        }
+        auto * denominator = ggml_scale_bias(ctx.ggml, beta, 1.0F, 1.0e-9F);
+        return core::wrap_tensor(
+            ggml_snake_beta_1d(ctx.ggml, contiguous.tensor, alpha, denominator), input.shape, GGML_TYPE_F32);
+    }
     return modules::SnakeBeta1dModule({channels, logscale}).build(ctx, input, weights);
