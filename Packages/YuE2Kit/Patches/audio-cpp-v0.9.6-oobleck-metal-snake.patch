diff --git a/external/ggml/src/ggml-metal/ggml-metal.metal b/external/ggml/src/ggml-metal/ggml-metal.metal
index 3d90ec0..4f1b24b 100644
--- a/external/ggml/src/ggml-metal/ggml-metal.metal
+++ b/external/ggml/src/ggml-metal/ggml-metal.metal
@@ -1254,6 +1254,29 @@ kernel void kernel_snake_1d_f32(
     y[0] = xv + s2/av;
 }
 
+// SnakeBeta preserves Oobleck's FP32 division and channel parameters.
+kernel void kernel_snake_beta_1d_f32(
+        constant ggml_metal_kargs_snake_1d & args [[buffer(0)]],
+        device const float * input [[buffer(1)]],
+        device const float * alpha [[buffer(2)]],
+        device const float * denominator [[buffer(3)]],
+        device float * output [[buffer(4)]],
+        uint i [[thread_position_in_grid]]) {
+    #pragma clang fp contract(off)
+    const uint frames = args.ne00;
+    const uint channel = i / frames;
+    if (channel >= uint(args.ne01)) {
+        return;
+    }
+
+    const float x = input[i];
+    const float ax = x * alpha[channel];
+    const float sine = sin(ax);
+    const float squared = sine * sine;
+    const float periodic = squared / denominator[channel];
+    output[i] = x + periodic;
+}
+
 typedef decltype(kernel_unary_impl<float, float, float>) kernel_unary_t;
 
 template [[host_name("kernel_unary_f32_f32")]]   kernel kernel_unary_t kernel_unary_impl<float,  float,  float>;
diff --git a/external/ggml/src/ggml.c b/external/ggml/src/ggml.c
index 8d20357..48a6056 100644
--- a/external/ggml/src/ggml.c
+++ b/external/ggml/src/ggml.c
@@ -3628,6 +3628,25 @@ struct ggml_tensor * ggml_snake_1d(
     return result;
 }
 
+struct ggml_tensor * ggml_snake_beta_1d(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * alpha,
+        struct ggml_tensor  * denominator) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && ggml_is_contiguous(a));
+    GGML_ASSERT(a->ne[2] == 1 && a->ne[3] == 1);
+    GGML_ASSERT(alpha->type == GGML_TYPE_F32 && ggml_is_contiguous(alpha));
+    GGML_ASSERT(denominator->type == GGML_TYPE_F32 && ggml_is_contiguous(denominator));
+    GGML_ASSERT(ggml_nelements(alpha) == a->ne[1] && ggml_nelements(denominator) == a->ne[1]);
+
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, a);
+    result->op     = GGML_OP_SNAKE_1D;
+    result->src[0] = a;
+    result->src[1] = alpha;
+    result->src[2] = denominator;
+    return result;
+}
