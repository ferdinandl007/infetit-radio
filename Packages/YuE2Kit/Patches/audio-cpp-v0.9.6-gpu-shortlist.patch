+// The GPU ranks raw scores. The existing CPU sampler applies the same seeded
+// draw, using this list only if excluded scores cannot enter the final top-k.
+std::optional<int32_t> sample_shortlist(
+    const engine::modules::CausalDecoderStepResult & step,
+    const std::vector<int32_t> & emitted,
+    const Yue2ARSamplingWindow & window, bool semantic,
+    std::mt19937 & rng, Yue2SamplerScratch & scratch) {
+    if (step.candidate_indices.size() != step.logits.size() || step.logits.empty() ||
+        window.sampling.top_k <= 0 || window.sampling.repetition_penalty < 1.0F ||
+        !std::isfinite(window.sampling.repetition_penalty)) {
+        return std::nullopt;
+    }
+    const int64_t rows = semantic ? kCodecSize + 1 : kAbcEndToken + 1;
+    const float missing = -std::numeric_limits<float>::infinity();
+    scratch.shortlist_logits.resize(static_cast<size_t>(rows), missing);
+    for (const int32_t index : scratch.shortlist_indices) {
+        scratch.shortlist_logits[static_cast<size_t>(index)] = missing;
+    }
+    scratch.shortlist_indices.clear();
+    float boundary = std::numeric_limits<float>::infinity();
+    const int64_t stop = semantic ? 0 : window.stop_token;
+    const int64_t begin = semantic ? 1 : window.begin;
+    const int64_t end = semantic ? rows : window.end;
+    for (size_t i = 0; i < step.logits.size(); ++i) {
+        const int32_t index = step.candidate_indices[i];
+        const float value = step.logits[i];
+        if (index < 0 || index >= rows || !std::isfinite(value)) return std::nullopt;
+        boundary = std::min(boundary, value);
+        if ((index >= begin && index < end) ||
+            (index == stop && static_cast<int64_t>(emitted.size()) >= window.min_tokens)) {
+            float & slot = scratch.shortlist_logits[static_cast<size_t>(index)];
+            if (slot != missing) return std::nullopt;
+            slot = value;
+            scratch.shortlist_indices.push_back(index);
+        }
+    }
+    const float penalty = window.sampling.repetition_penalty;
+    if (penalty != 1.0F) {
+        const auto start = std::max<int64_t>(0, static_cast<int64_t>(emitted.size()) - window.sampling.penalty_window);
+        for (int64_t i = start; i < static_cast<int64_t>(emitted.size()); ++i) {
+            const int32_t token = emitted[static_cast<size_t>(i)];
+            const int32_t index = semantic ? compact_semantic_index(token) : token;
+            if (index < 0 || index >= rows) continue;
+            float & value = scratch.shortlist_logits[static_cast<size_t>(index)];
+            value = value < 0.0F ? value * penalty : value / penalty;
+        }
+    }
+    // A strict cutoff also handles ties at the GPU top-k boundary.
+    int64_t above = 0;
+    for (const int32_t index : scratch.shortlist_indices) {
+        if (scratch.shortlist_logits[static_cast<size_t>(index)] > boundary) ++above;
+    }
+    if (above < window.sampling.top_k) return std::nullopt;
+    const int32_t index = sample_from_allowed_ranges(
+        scratch.shortlist_logits, {}, window.sampling, rng, scratch, "Yue2 GPU shortlist", &scratch.shortlist_indices);
+    return semantic ? (index == 0 ? kMusicEndToken : kCodecOffset + index - 1) : index;
+}
